projection;
strict ( 2 );
use draft;
define behavior for zc_4859_user alias User
{
  use create;
  use update;
  use delete;

  use action uploadExcelData;
  use action DownloadExcel;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _UserDev { create; }
}

define behavior for ZC_4859_user_dev alias UserDev
{
  use update;
  use delete;

  use association _User { with draft;}
}